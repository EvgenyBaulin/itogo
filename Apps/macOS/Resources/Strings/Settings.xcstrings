    "report.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One file to hand over when something breaks. It holds the journal, versions and counts — never amounts, names or descriptions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл, который можно отдать на разбор, когда что-то сломалось. В нём журнал, версии и количества — и никогда суммы, имена или описания."
          }
        }
      }
    },
    "report.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session before this one did not end: the application was stopped or it crashed. A problem report will say what happened."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс перед этим не завершился: приложение остановили или оно упало. Отчёт о проблеме покажет, что случилось."
          }
        }
      }
    },
