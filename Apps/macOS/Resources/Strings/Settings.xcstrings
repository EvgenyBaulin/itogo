    "settings.updates.automaticHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day the app looks for a new version, downloads it in the background and installs it on quit. Off: an update comes only through “Reload & Update”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день приложение ищет новую версию, скачивает её в фоне и ставит при выходе. Выключено: обновление придёт только по «Обновить и перезапустить»."
          }
        }
      }
    },
    "settings.updates.unavailableHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not look for updates: it carries no key to check the signature of an update with."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка не ищет обновлений: в ней нет ключа, которым проверяется подпись обновления."
          }
        }
      }
    },
    "templates.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates fill themselves from what you enter. Pinned ones always stay first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны сами набираются из того, что вы вводите. Закреплённые всегда идут первыми."
          }
        }
      }
