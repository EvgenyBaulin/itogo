      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "versions of the app, the build, macOS, the database schema and the dependencies"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "версии приложения, сборки, macOS, схемы базы и зависимостей"
