{
  "sourceLanguage": "en",
  "strings": {
    "archive.error.checksum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file inside the archive does not match its checksum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл внутри архива не сходится с контрольной суммой"
          }
        }
      }
    },
    "archive.error.damaged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is damaged or is not an Itogo archive"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл повреждён или это не архив Itogo"
          }
        }
      }
    },
    "archive.error.database": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database inside the archive cannot be opened. Nothing was replaced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу внутри архива открыть не удалось. Ничего не заменено."
          }
        }
      }
    },
    "archive.error.manifest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive has no readable manifest"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В архиве нет читаемого манифеста"
          }
        }
      }
    },
    "archive.error.newerFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive was written by a newer version of the app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив записан более новой версией приложения"
          }
        }
      }
    },
    "archive.error.newerSchema": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive uses a newer database schema — update the app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В архиве более новая схема базы — обновите приложение"
          }
        }
      }
    },
    "archive.error.password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong password, or the file was edited after it was written"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный пароль — или файл изменили после записи"
          }
        }
      }
    },
    "archive.error.rowCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive holds a different number of records than it claims"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В архиве другое число записей, чем он заявляет"
          }
        }
      }
    },
    "archive.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Archive…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгрузить архив…"
          }
        }
      }
    },
    "archive.export.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive is written and checked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив записан и проверен"
          }
        }
      }
    },
    "archive.export.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive could not be written"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив записать не удалось"
          }
        }
      }
    },
    "archive.export.working": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing the archive and checking it…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив записывается и проверяется…"
          }
        }
      }
    },
    "archive.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Archive…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить архив…"
          }
        }
      }
    },
    "archive.import.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the app is replaced by what is inside the archive. A copy of the current state is written first, and the app restarts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что есть в приложении, заменится содержимым архива. Копия текущего состояния будет сделана заранее, затем приложение перезапустится."
          }
        }
      }
    },
    "archive.import.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive could not be opened"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив открыть не удалось"
          }
        }
      }
    },
    "archive.import.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load this archive?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить этот архив?"
          }
        }
      }
    },
    "archive.import.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive cannot be loaded while the database is not open. Restore a copy in Settings → Backups first, then open the archive again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока база не открыта, архив не загрузить. Сначала восстановите копию: Настройки → Бэкапы, — затем откройте архив снова."
          }
        }
      }
    },
    "archive.import.working": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the archive and checking it…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив открывается и проверяется…"
          }
        }
      }
    },
    "archive.noPassword.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything inside — names of people, places and every amount — will lie in the open. Anyone who gets the file can read it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё внутри — имена людей, места и все суммы — будет лежать в открытом виде. Любой, у кого окажется файл, это прочитает."
          }
        }
      }
    },
    "archive.noPassword.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the archive without a password?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать архив без пароля?"
          }
        }
      }
    },
    "archive.password.again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same password again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот же пароль ещё раз"
          }
        }
      }
    },
    "archive.password.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it empty to write the archive without encryption."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы записать архив без шифрования."
          }
        }
      }
    },
    "archive.password.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль"
          }
        }
      }
    },
    "archive.password.mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two passwords differ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароли не совпадают"
          }
        }
      }
    },
    "archive.password.mismatch.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the same password in both fields. The archive will open only with exactly what you type."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите один и тот же пароль в оба поля. Архив откроется только тем паролем, который вы введёте."
          }
        }
      }
    },
    "archive.password.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password for the archive"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль для архива"
          }
        }
      }
    },
    "backups.afterImport.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас"
          }
        }
      }
    },
    "backups.afterImport.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data came from an archive, and folders chosen on another Mac do not travel with it. Choose where copies of the backups go — for example, a folder in iCloud Drive. Until then the copies stay on this Mac only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные загружены из архива, а папки, выбранные на другом Mac, с ним не переносятся. Выберите, куда класть копии бэкапов, — например, папку в iCloud Drive. Пока она не выбрана, копии остаются только на этом Mac."
          }
        }
      }
    },
    "backups.afterImport.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder for copies"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку для копий"
          }
        }
      }
    },
    "backups.dataSet.noMirror": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A data set keeps its copies in its own folder: they go to no chosen folder, and the folder chosen for your own data stays as it is"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор данных хранит копии в своей папке: в выбранную папку они не идут, а папка, выбранная для ваших данных, остаётся прежней"
          }
        }
      }
    },
    "backups.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No copies yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копий пока нет"
          }
        }
      }
    },
    "backups.failure.damaged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last copy did not pass the integrity check"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя копия не прошла проверку целостности"
          }
        }
      }
    },
    "backups.failure.folderNotRemembered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder could not be remembered, so copies do not go there. Choose another folder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранную папку не удалось запомнить, поэтому копии туда не идут. Выберите другую папку"
          }
        }
      }
    },
    "backups.failure.mirrorUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder cannot be opened. Choose it again, or copies will not reach it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная папка не открывается. Выберите её заново — иначе копии туда не попадут"
          }
        }
      }
    },
    "backups.failure.notMirrored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last copy did not reach the chosen folder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя копия не попала в выбранную папку"
          }
        }
      }
    },
    "backups.failure.notWritten": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last copy could not be written"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнюю копию записать не удалось"
          }
        }
      }
    },
    "backups.older": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld older copy"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld older copies"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld более старые копии"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld более старых копий"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld более старая копия"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld более старой копии"
                }
              }
            }
          }
        }
      }
    },
    "backups.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить…"
          }
        }
      }
    },
    "backups.restore.damaged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy is damaged and cannot be restored. Nothing was replaced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия повреждена, восстановить из неё нельзя. Ничего не заменено."
          }
        }
      }
    },
    "backups.restore.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy could not be restored. Nothing was replaced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить копию. Ничего не заменено."
          }
        }
      }
    },
    "backups.restore.newer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy was written by a newer version of Itogo: update the app to restore it. Nothing was replaced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту копию записала более новая версия «Итого»: чтобы восстановить её, обновите приложение. Ничего не заменено."
          }
        }
      }
    },
    "backups.restore.noSafetyCopy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current data could not be copied first, so nothing was replaced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сначала сохранить копию текущих данных, поэтому ничего не заменено."
          }
        }
      }
    },
    "backups.restoreConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace all current data with this copy?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить все текущие данные этой копией?"
          }
        }
      }
    },
    "categories.add.parentRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category goes only under a category of the same kind that is not in the archive. Choose the parent again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорию можно положить только в категорию того же вида, которая не в архиве. Выберите родителя ещё раз."
          }
        }
      }
    },
    "categories.archived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "archived"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "в архиве"
          }
        }
      }
    },
    "categories.cashback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback category"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория кэшбэка"
          }
        }
      }
    },
    "categories.cashbackHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income in this category and its subcategories counts as cashback in Analytics."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход в этой категории и её подкатегориях Analytics считает кэшбэком."
          }
        }
      }
    },
    "categories.delete.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is used by %2$@. Put the category in the archive instead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На «%1$@» %2$@. Отправьте категорию в архив."
          }
        }
      }
    },
    "categories.delete.blocked.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld operation in the bin, and it cannot be moved"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld operations in the bin, and those cannot be moved"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ссылаются %lld удалённые операции, а их перенести нечем"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ссылаются %lld удалённых операций, а их перенести нечем"
                }
              },
              "one": {
                "stringUnit": {
