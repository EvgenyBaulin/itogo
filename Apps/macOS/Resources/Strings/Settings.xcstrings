    "settings.planning.limitsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the limit first, then close to it, then by the share spent. The Overview card shows five at most; when there are more limits than this number, all of them are under «All limits…» in Planning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала превышенные, затем на грани, затем по доле потраченного. Карточка «Обзора» показывает не больше пяти; если лимитов больше этого числа, все они — по кнопке «Все лимиты…» в «Планировании»."
          }
        }
      }
    },
