    "settings.planning.includesGoalsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the grey line of the free sum subtracts what is already saved in goals. Turn it off when goal money is kept on an account outside the summary."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, серая строка свободной суммы вычитает то, что уже отложено на цели. Выключите, если деньги целей лежат на счёте вне сводки."
          }
        }
      }
    },
    "settings.planning.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits"
          }
