    "references.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations of «%1$@» move to «%2$@», its name becomes an alias of «%2$@», and «%1$@» goes to the archive. A merge cannot be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции «%1$@» перейдут к «%2$@», его название станет алиасом «%2$@», а сам «%1$@» уйдёт в архив. Объединение нельзя отменить."
          }
        }
      }
    },
