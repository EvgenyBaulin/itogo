    "account.handOver.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main instead. The most used one is picked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите счёт, который станет основным вместо него. Предложен самый используемый."
          }
        }
      }
    },
