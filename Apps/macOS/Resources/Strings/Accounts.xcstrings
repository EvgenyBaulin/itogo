    "account.group.holdsMain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is in this group, so it always counts in the summary."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе основной счёт, поэтому она всегда в общей сводке."
