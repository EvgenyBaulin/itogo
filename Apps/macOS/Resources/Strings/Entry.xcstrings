    "reimbursement.differentPeople": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ticked parts are owed by different people. Choose whose money came back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечены части разных людей. Выберите, чьи деньги вернулись."
          }
        }
      }
    },
    "reimbursement.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reimbursement could not be recorded"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат записать не удалось"
          }
        }
      }
    },
    "reimbursement.noSurcharges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More came back than the parts cost, and there is no Surcharges category for the difference. Nothing was recorded: enter no more than the parts cost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернули больше, чем стоили части, а категории «Доплаты» для разницы нет. Ничего не записано: введите сумму не больше стоимости частей."
          }
        }
      }
    },
    "reimbursement.partGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chosen part is no longer waiting for its money — its purchase was deleted, or the part was written off or closed. The list has been refreshed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная часть больше не ожидает возврата — покупку удалили, часть списали или уже закрыли. Список обновлён."
          }
        }
      }
    },
    "reimbursement.provisionalRate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this purchase is still being refined — press ⌘R and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этой покупки ещё уточняется — нажмите ⌘R и попробуйте снова."
