    "relaunch.failed.helper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Itogo could not prepare its restart: %@. Nothing was closed, and the app keeps working. To restart it, quit it and open it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итого не смогло подготовить перезапуск: %@. Ничего не закрыто, приложение продолжает работать. Чтобы перезапустить его, закройте и откройте снова."
          }
        }
      }
    },
